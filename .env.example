# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=protein_comparison_db
DB_USER=root
DB_PASSWORD=

# Configuración de Flask
SECRET_KEY=dev-secret-key-change-in-production

# Configuración de APIs
SWISSMODEL_API_BASE_URL=https://swissmodel.expasy.org/
UNIPROT_API_BASE_URL=https://rest.uniprot.org/uniprotkb
SWISSMODEL_API_ENDPOINT=https://swissmodel.expasy.org/
SWISS_MODEL_TOKEN=

# Configuración de SwissModel
MODELS_DIRECTORY=models/swissmodel
API_TIMEOUT=900
MAX_SEQUENCE_LENGTH=2000
ENABLE_SWISSMODEL=true

# Configuración de ColabFold (opcional)
COLABFOLD_ENDPOINT=http://localhost:8080
