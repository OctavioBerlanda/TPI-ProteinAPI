# Configuración de la aplicación TPI-ProteinAPI
# Copia este archivo como .env y configura tus valores

# Configuración de base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=protein_comparison_db
DB_USER=root
DB_PASSWORD=

# Configuración de APIs
ALPHAFOLD_API_BASE_URL=https://alphafold.ebi.ac.uk/api
UNIPROT_API_BASE_URL=https://rest.uniprot.org/uniprotkb
ALPHAFOLD_API_ENDPOINT=https://alphafolddb.org/api
COLABFOLD_ENDPOINT=http://localhost:8080

# Token de SWISS-MODEL (IMPORTANTE: Configura tu propio token aquí)
# Obtén tu token gratis en: https://swissmodel.expasy.org/docs/
SWISS_MODEL_TOKEN=9760500d5ab9a0ea91779f61b8a5215512856d92

# Configuración de AlphaFold
MODELS_DIRECTORY=models/alphafold
API_TIMEOUT=300
MAX_SEQUENCE_LENGTH=2000
ENABLE_ALPHAFOLD=true

# Configuración de seguridad
SECRET_KEY=tu-clave-secreta-muy-segura-aqui
